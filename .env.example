# ----------------------------------------------------------------------------
# monitor - environment template
#
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#   cp .env.example .env
#
# Rotate any credential that has ever appeared in git history.
# ----------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=3030

# --- Database ---------------------------------------------------------------
# MONGO_PASSWORD is used by docker-compose for BOTH the mongo root user and the
# app's MONGODB_URI. server.js also reads it directly to provision the Swarm
# mongo service, so it must be present in the app container environment.
# Generate: openssl rand -base64 32
MONGO_PASSWORD=change-me
MONGODB_URI=mongodb://monitor:change-me@monitor-mongo:27017/monitor?authSource=admin

# --- Auth / sessions --------------------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=https://monitor.eaqdragon.com
# Alternate names read by some code paths; set to the same values.
AUTH_SECRET=change-me
AUTH_URL=https://monitor.eaqdragon.com

# --- Encryption -------------------------------------------------------------
# Encrypts stored connection credentials. Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-me
# Only set while rotating: decrypts existing records before re-encrypting.
# ENCRYPTION_KEY_OLD=
# Encrypts database backups.
# BACKUP_ENCRYPTION_KEY=

# --- Email (Resend) ---------------------------------------------------------
# Without a valid key + a VERIFIED sending domain, /api/auth/forgot-password
# returns 500.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Monitor <onboarding@yourdomain.com>

# --- Rate limiting ----------------------------------------------------------
# Optional. When unset, an in-process limiter is used (per-container, resets on
# restart). Set both to share limits across replicas via Upstash.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Number of reverse proxies in front of the app. Set this correctly or every
# request will be rate-limited as a single IP.
TRUSTED_PROXY_HOPS=1
# Emergency escape hatch only - never enable in production.
RATE_LIMIT_DISABLE=0

# --- Passkeys (WebAuthn) ----------------------------------------------------
WEBAUTHN_RP_ID=monitor.eaqdragon.com
WEBAUTHN_RP_NAME=Monitor
WEBAUTHN_ORIGIN=https://monitor.eaqdragon.com

# --- Optional integrations --------------------------------------------------
# MFA_ISSUER=Monitor
# MFA_REQUIRE_ADMINS=0
# ADMIN_EMAIL=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GDRIVE_REDIRECT_URI=
# GROQ_API_KEY=
# SKILLS_MP_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# KOFI_WEBHOOK_TOKEN=
# NEXT_PUBLIC_KOFI_PAGE_URL=

# --- Relay ------------------------------------------------------------------
# Lifetime of local-relay install tokens, in days.
RELAY_TOKEN_TTL_DAYS=365

# --- Headers / CSP ----------------------------------------------------------
# Restricts the local-relay script origin allowed by the CSP.
# CSP_ALLOW_LOCAL_RELAY=0
# CSP_LOCAL_RELAY=
# Cross-Origin-Embedder-Policy. Enabling can break third-party embeds.
# COEP=0
# Comma-separated allowlist for outbound webhook/callback URLs (SSRF guard).
# CALLBACK_URL_ALLOWLIST=
