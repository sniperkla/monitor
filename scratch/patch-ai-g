/**
 * One-off patch: gate AI routes behind supporter membership.
 * Safe to re-run — skips files already patched.
 */
const fs = require('fs');

function patch(p, edits) {
  let s = fs.readFileSync(p, 'utf8');
  if (s.includes('canUseServerAi')) { console.log('SKIP (already patched):', p); return; }
  for (const [anchor, replacement] of edits) {
    if (!s.includes(anchor)) {
      console.error('ANCHOR NOT FOUND in', p, ':', JSON.stringify(anchor.slice(0, 80)));
      process.exit(1);
    }
    s = s.replace(anchor, replacement);
  }
  fs.writeFileSync(p, s);
  console.log('patched OK:', p);
}

const IMP = "import { canUseServerAi, aiSupporterRequiredResponse } from '@/utils/supporter';
";

const GATE_OWN_KEY = [
  '    // AI is a supporter feature - server-funded AI requires membership.',
  '    // Users bringing their own API key (manual mode) are always allowed.',
  "    const usingOwnKey = model === 'manual' && !!prefs?.aiApiKey;",
  '    if (!(await canUseServerAi(session.user.email, usingOwnKey))) {',
  '      return aiSupporterRequiredResponse();',
  '    }',
  '',
].join('
');

