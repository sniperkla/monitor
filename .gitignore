# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# Wildcard, not just /.next/: Tailwind v4 auto-detects sources and only skips
# gitignored paths, so a stray build dir like .next-verify gets scanned. Its
# Turbopack cache yields mangled arbitrary-value utilities that fail to parse
# and 500 the whole dev server. Always build into ./tmp/<name> instead, and
# keep this pattern broad.
# NOTE: never paste a literal example of a mangled utility here. Tailwind v4
# scans this file too and will extract it as a real class, recreating the bug.
/.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the documented template must stay tracked
!.env.example
db-config.json
.relay-tokens.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
RECOVERY_CODE.txt

# scratch & test artifacts
scratch/
.fleet-e2e.py
# scratch Next.js dist dirs created during local builds (NEXT_DIST_DIR=tmp/mb3 etc)
/tmp/

# Built Local Relay artifact (generated by scripts/build-relay.mjs)
public/local-relay.min.js
